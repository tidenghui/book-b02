  },
  {
    "who": "老周",
    "trait": "说话时把烟从耳朵上取下、在柜台沿磕两下、捻掉一截烟丝，不点又别回耳朵",
    "fromChapter": 12
  },
  {
    "who": "母亲",
    "trait": "说话一句一句往外递，紧张时攥轮椅扶手、钥匙串换手，钥匙串上挂一张磨圆边角的公交卡",
    "fromChapter": 12
  }
