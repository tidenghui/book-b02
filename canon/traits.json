    "trait": "走路时左脚鞋跟先着地，每一步比右脚重半拍；皮鞋后跟磨掉一小块",
    "fromChapter": 1
  },
  {
    "who": "主角",
    "trait": "左眉尾有旧疤，摸上去比旁边的皮平一点",
    "fromChapter": 1
  },
  {
    "who": "林律师",
    "trait": "左脚鞋跟磕地比右脚重半拍，走路时笃笃笃。",
    "fromChapter": 2
  },
  {
    "who": "林律师",
    "trait": "说话时动作顺得像排练过，递笔尖朝人像递手术刀。",
    "fromChapter": 2
  },
  {
    "who": "陈默",
    "trait": "记录时用标尺压纸页边，贴标压平，按规程拍照贴标编号。",
    "fromChapter": 2
  },
  {
    "who": "chenmo",
    "trait": "紧张或犹豫时反复拔笔帽又盖上",
    "fromChapter": 3
  },
  {
    "who": "chenmo",
    "trait": "对清单外物品保持一步距离，伸手够不着但眼能看清",
    "fromChapter": 3
  },
  {
    "who": "chenmo",
    "trait": "说话留半句，常把到嘴边的话咽回去",
    "fromChapter": 3
  },
  {
    "who": "chenmo",
    "trait": "核对清单时一件一件报编号和物品名，用标尺压纸页边、用指甲刮平卡片边角对边角",
    "fromChapter": 4
  },
  {
    "who": "chenmo",
    "trait": "拆开牛皮纸包前先拍照三张带柜号入镜，拆时用镊子挑死结，复原时用手按三遍确认比原来紧",
    "fromChapter": 4
  },
  {
    "who": "xuhai",
    "trait": "说话时把渔夫帽帽檐往下压，拇指在记账本上反复蹭，拿铅笔头在账本上画圈又用橡皮擦一半停住",
    "fromChapter": 4
  },
  {
    "who": "母亲",
    "trait": "攥钥匙串时指节发白，手背有一小块圆形烫疤，说话时把钥匙串换手攥。",
    "fromChapter": 5
  },
  {
    "who": "陈默",
    "trait": "数数习惯：数钥匙把数、数台阶（一层十一级）、把数字记在脑子里像记编号。",
    "fromChapter": 5
  },
  {
    "who": "陈默",
    "trait": "拍照留证：拍手机位置和背面、拍钥匙串齿口，拍完原样放回。",
    "fromChapter": 5
  },
  {
    "who": "老周",
    "trait": "说话前嘴唇先动几下，像在心里默念；紧张时反复翻台历、摸抽屉边又缩手。",
    "fromChapter": 6
  },
  {
    "who": "老周",
    "trait": "抽烟不点先夹耳朵上，取下来在柜台磕两下，烟丝掉出来用手指一粒粒捻掉。",
    "fromChapter": 6
  },
  {
    "who": "陈默",
    "trait": "用标尺压纸页边、用指甲刮平卷角，拉链拉上后按两下。",
    "fromChapter": 6
  },
  {
    "who": "陈默",
    "trait": "习惯拔笔帽又盖上反复多次",
    "fromChapter": 7
  },
  {
    "who": "陈默",
    "trait": "记录本拉链拉上后按两下",
    "fromChapter": 7
  },
  {
    "who": "林律师",
    "trait": "鞋跟磕地左脚重半拍",
    "fromChapter": 7
  },
  {
    "who": "linlvshi",
    "trait": "走路鞋跟磕地，左脚那下重半拍，停步时纸页翻一响就合上，合得轻",
    "fromChapter": 8
  },
  {
    "who": "chenmo",
    "trait": "签名“默”字最后一捺总是平的，从不往上挑；写字收笔急",
    "fromChapter": 8
  },
  {
    "who": "chenmo",
    "trait": "习惯拔笔帽、盖上、又拔下来，反复几次",
    "fromChapter": 8
  },
  {
    "who": "陈默",
    "trait": "习惯拍照存档，先拍整体再拍局部，按顺序编号",
    "fromChapter": 9
  },
  {
    "who": "老周",
    "trait": "说话前嘴唇动两下默念，爱把烟夹耳朵上又取下，捻烟丝不点",
    "fromChapter": 9
  },
  {
    "who": "陈默",
    "trait": "折回执时对齐边角压出实痕，反复展开折回",
    "fromChapter": 9
  },
  {
    "who": "陈默",
    "trait": "习惯反复拔笔帽又盖上，用指甲刮平回执边缘对折压出实痕",
    "fromChapter": 10
  },
  {
    "who": "老周",
    "trait": "说话前把烟从耳朵上取下在柜台沿磕，捻掉烟丝才开口；贴胶带每一道从头捋到尾",
    "fromChapter": 10
  },
  {
    "who": "陈曦",
    "trait": "写字“默”字收笔上挑，学陈默的字又没学全；笑时找准位置笑",
    "fromChapter": 10
  },
  {
    "who": "chenmo",
    "trait": "写数字“7”习惯加一横，只有家里人有这个习惯。",
    "fromChapter": 11
  },
  {
